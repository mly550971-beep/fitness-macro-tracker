{
  "name": "fitness-macro-tracker",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -k -n server,client -c green,blue \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "test": "npm run test -w server",
    "check": "npm run check -w server",
    "audit": "npm audit --workspaces --audit-level=high"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
